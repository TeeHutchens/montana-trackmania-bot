{
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.formatOnSave": false,
  "javascript.preferences.quoteStyle": "single",
  "files.exclude": {
    "node_modules": true,
    "logs": true
  },
  "search.exclude": {
    "node_modules": true,
    "logs": true,
    "cache/*.json": false
  },
  "editor.rulers": [120],
  "files.associations": {
    ".env.example": "dotenv",
    ".env": "dotenv"
  }
}
