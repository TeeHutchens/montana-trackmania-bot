# Montana Trackmania Bot — Environment Configuration
# Copy this file to .env and fill in your actual values

# Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_id_here
GUILD_ID=your_discord_server_id_here

# Ubisoft / Nadeo credentials (used for Trackmania Live Services API)
UBI_USERNAME=your_ubisoft_account_email
UBI_PASSWORD=your_ubisoft_account_password

# api.trackmania.com OAuth2 app credentials
# Register at https://api.trackmania.com to get these
APP_IDENTIFIER=your_oauth2_client_id
APP_SECRET=your_oauth2_client_secret

# Comma-separated list of enabled Discord slash commands
ALLOWED_COMMANDS=weeklyshorts,campaign
